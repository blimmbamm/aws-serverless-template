# Optional: set after first deploy for local API JWT verification
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=eu-central-1

# Origin secret (must match CloudFront custom header in prod)
ORIGIN_VERIFY_SECRET=dev-origin-secret

# Optional Neon / Postgres (leave empty to use in-memory dummy data)
DATABASE_URL=
